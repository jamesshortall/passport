# ---------------------------------------------------------------------------
# AppPassport environment variables
# Copy to .env.local and fill in from your Supabase project settings.
# ---------------------------------------------------------------------------

# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://xkaeaupdopopjbhrxzsp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key
NEXT_PUBLIC_SITE_URL=https://passport.traveltechnician.info

# Server-only — NEVER expose to the browser. Used by admin actions and
# edge-function-adjacent server code that must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Sanity CMS (optional) — manages Legal pages, FAQ, and What's New --------
# Leave unset and the app falls back to built-in content. See docs/SANITY.md.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01
# SANITY_WRITE_TOKEN=sk...            # only for the one-time content import

# --- Edge Function secrets (set via `supabase secrets set`, not here) -------
# OPENAI_API_KEY=sk-...               # for AI-assisted country drafting/refresh
# RESEND_API_KEY=re_...               # for approval + digest emails
# RESEND_FROM=AppPassport <hello@traveltechnician.info>
